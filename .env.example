# ตัวอย่างไฟล์ตั้งค่า — install.ps1 จะสร้างไฟล์ .env จริงให้ (ห้ามนำ .env เข้า Git)

# production | staging | development | training
APP_ENV=production

# โฟลเดอร์ข้อมูล (ฐานข้อมูล + รูปถ่าย) — สภาพแวดล้อมทดสอบต้องใช้โฟลเดอร์แยก
DATA_DIR=C:\RehabData\data

# ชุดที่ 1: โฟลเดอร์สำรองในเครื่อง
BACKUP_LOCAL_DIR=C:\RehabData\backups

# กุญแจเข้ารหัสไฟล์สำรอง AES-256 (เลขฐานสิบหก 64 ตัว) — พิมพ์ใส่ซองปิดผนึกให้หัวหน้าเก็บ
# ถ้ากุญแจหาย จะเปิดไฟล์สำรองไม่ได้อีกเลย
BACKUP_KEY=

# พอร์ต HTTPS และไฟล์ใบรับรอง (mkcert)
PORT=443
HTTPS_CERT=C:\RehabData\certs\server.pem
HTTPS_KEY=C:\RehabData\certs\server-key.pem
